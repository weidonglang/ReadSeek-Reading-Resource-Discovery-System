# ReadSeek local development environment.
# Copy to .env or run start-readseek.bat once and it will be created automatically.
# Values here are safe examples; rotate them before sharing a real deployment.

# Docker / database
POSTGRES_DB=book_recommendation_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=readseek-local-postgres-change-me
POSTGRES_PORT=5043

# Spring datasource for local host runs
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5043/book_recommendation_system
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=readseek-local-postgres-change-me

# Service ports
SERVER_PORT=8010
SERVER_CONTEXT_PATH=/readseek-service
SPRING_ELASTICSEARCH_URIS=http://localhost:9200
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Security and bootstrap admin
LIBRARY_SECURITY_JWT_SECRET=replace-with-a-long-random-local-dev-secret
LIBRARY_BOOTSTRAP_ADMIN_ENABLED=true
LIBRARY_BOOTSTRAP_ADMIN_EMAIL=admin@booknook.local
LIBRARY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-your-local-admin-password
LIBRARY_BOOTSTRAP_ADMIN_RESET_PASSWORD=true
LIBRARY_BOOTSTRAP_ADMIN_FIRST_NAME=System
LIBRARY_BOOTSTRAP_ADMIN_LAST_NAME=Admin
READSEEK_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Search / embedding / reranker
LIBRARY_SEARCH_ENABLED=true
LIBRARY_SEARCH_VECTOR_ENABLED=true
LIBRARY_SEARCH_VECTOR_CANDIDATE_LIMIT=20
LIBRARY_SEARCH_VECTOR_MIN_SCORE=0.0
LIBRARY_SEARCH_EMBEDDING_ENABLED=true
LIBRARY_SEARCH_EMBEDDING_PROVIDER=local-ai
LIBRARY_SEARCH_EMBEDDING_BASE_URL=http://127.0.0.1:8001
LIBRARY_SEARCH_EMBEDDING_MODEL=BAAI/bge-m3
LIBRARY_SEARCH_EMBEDDING_DIMENSIONS=1024
LIBRARY_SEARCH_EMBEDDING_TIMEOUT_MS=30000
LIBRARY_SEARCH_RERANKER_ENABLED=true
LIBRARY_SEARCH_RERANKER_PROVIDER=local-ai
LIBRARY_SEARCH_RERANKER_BASE_URL=http://127.0.0.1:8001
LIBRARY_SEARCH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LIBRARY_SEARCH_RERANKER_TIMEOUT_MS=30000
LIBRARY_SEARCH_RERANKER_CANDIDATE_LIMIT=20

# RAG / local Ollama
LLM_PROVIDER=ollama
RAG_DEFAULT_MODE=standard
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_STREAM=false
OLLAMA_THINK=false
RAG_FAST_MODEL=qwen2.5:7b
RAG_STANDARD_MODEL=qwen3:8b
RAG_EXPERT_MODEL=qwen3:14b
FAST_TEMPERATURE=0.2
STANDARD_TEMPERATURE=0.2
EXPERT_TEMPERATURE=0.1
FAST_TOP_P=0.9
STANDARD_TOP_P=0.9
EXPERT_TOP_P=0.85
FAST_NUM_CTX=4096
STANDARD_NUM_CTX=4096
EXPERT_NUM_CTX=8192
FAST_KEEP_ALIVE=5m
STANDARD_KEEP_ALIVE=10m
EXPERT_KEEP_ALIVE=2m

# Optional online OpenAI-compatible AI provider. Disabled until configured.
ONLINE_AI_ENABLED=false
ONLINE_AI_BASE_URL=
ONLINE_AI_CHAT_COMPLETIONS_ENDPOINT=/chat/completions
ONLINE_AI_API_KEY=
ONLINE_AI_MODEL=gpt-4o-mini
